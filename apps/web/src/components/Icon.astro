---
/**
 * Iconos de línea ultra-fina (estilo Phosphor Light), stroke 1.25.
 * Sin librerías de iconos pesadas: SVG inline, cero JS.
 */
interface Props {
  name:
    | 'arrow-up-right'
    | 'compass'
    | 'graph'
    | 'shield'
    | 'brain'
    | 'network'
    | 'terminal'
    | 'eye'
    | 'github'
    | 'npm';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
const sw = 1.25;
---

{
  name === 'arrow-up-right' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'compass' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width={sw} />
      <path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'graph' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="6" cy="6" r="2.4" stroke="currentColor" stroke-width={sw} />
      <circle cx="18" cy="9" r="2.4" stroke="currentColor" stroke-width={sw} />
      <circle cx="9" cy="18" r="2.4" stroke="currentColor" stroke-width={sw} />
      <path d="m7.9 7.6 8.2 2.8M7.7 16.2l7.6-4.9" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'shield' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 3 5 6v5c0 4.2 2.9 7.7 7 9 4.1-1.3 7-4.8 7-9V6l-7-3Z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
      <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'brain' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 5.5a3 3 0 0 0-5.9-.7A3 3 0 0 0 4 9.4a3 3 0 0 0 1 5.3A3 3 0 0 0 9 19a3 3 0 0 0 3-1.8m0-11.7a3 3 0 0 1 5.9-.7A3 3 0 0 1 20 9.4a3 3 0 0 1-1 5.3A3 3 0 0 1 15 19a3 3 0 0 1-3-1.8m0-11.7v11.7" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'network' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="5" r="2.2" stroke="currentColor" stroke-width={sw} />
      <circle cx="5" cy="18" r="2.2" stroke="currentColor" stroke-width={sw} />
      <circle cx="19" cy="18" r="2.2" stroke="currentColor" stroke-width={sw} />
      <path d="M12 7.2v4.6m0 0-5 4.4m5-4.4 5 4.4" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'terminal' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="4.5" width="18" height="15" rx="2.5" stroke="currentColor" stroke-width={sw} />
      <path d="m7 9.5 3 2.5-3 2.5M13 15h4" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'eye' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
      <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width={sw} />
    </svg>
  )
}
{
  name === 'github' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 19c-4 1.2-4-1.8-5.5-2.2M15 21v-3.2a2.7 2.7 0 0 0-.8-2.1c2.6-.3 5.3-1.3 5.3-5.7a4.4 4.4 0 0 0-1.2-3.1 4.1 4.1 0 0 0-.1-3.1s-1-.3-3.3 1.2a11.3 11.3 0 0 0-6 0C6.6 3.5 5.6 3.8 5.6 3.8a4.1 4.1 0 0 0-.1 3.1A4.4 4.4 0 0 0 4.3 10c0 4.3 2.7 5.3 5.3 5.7a2.7 2.7 0 0 0-.7 2.1V21" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'npm' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="7" width="18" height="10" rx="1.5" stroke="currentColor" stroke-width={sw} />
      <path d="M7 17v-6h2v4m2 2v-6h3v6m-1.5-6v4M17 11h1.5v6" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
