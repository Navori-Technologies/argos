---
import Icon from './Icon.astro';

/**
 * "Qué es": motor global (una vez en ~/.claude) vs. datos por repo.
 * Diagrama con CSS puro (líneas SVG + nodos), animado solo con transform/opacity.
 */
const repos = ['api', 'web', 'worker', 'mobile'];
---

<section id="que-es" class="relative mx-auto max-w-6xl px-6 py-28 md:py-40">
  <div class="grid items-center gap-16 lg:grid-cols-2">
    <div>
      <p data-reveal class="mb-5 inline-block rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-[10px] font-medium uppercase tracking-[0.2em] text-brand">
        La idea
      </p>
      <h2 data-reveal style="--reveal-delay: 60ms" class="text-balance text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        El motor vive una vez.<br />Los repos solo llevan datos.
      </h2>
      <p data-reveal style="--reveal-delay: 120ms" class="mt-7 text-lg leading-relaxed text-mist-300">
        Agentes, skills y hooks viven a nivel usuario en <code class="rounded bg-white/5 px-1.5 py-0.5 font-mono text-sm text-http">~/.claude</code>.
        Cada repo solo guarda su <code class="rounded bg-white/5 px-1.5 py-0.5 font-mono text-sm text-constant">argos.config.json</code> y una ficha delgada:
        el stack, el quality gate y las convenciones. Un solo motor gobierna todos tus proyectos, sin copiar maquinaria por repo.
      </p>
      <ul data-reveal style="--reveal-delay: 180ms" class="mt-8 space-y-3 text-mist-300">
        <li class="flex items-start gap-3"><span class="mt-1 text-brand"><Icon name="shield" class="h-4 w-4" /></span> Actualizas el motor una vez; todos los repos lo heredan.</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-http"><Icon name="compass" class="h-4 w-4" /></span> Cada repo declara sus datos; nada se hardcodea en runtime.</li>
      </ul>
    </div>

    <!-- Diagrama: núcleo global irradiando a los repos -->
    <div data-reveal style="--reveal-delay: 120ms" class="relative">
      <div class="bezel-card rounded-[2rem] border border-white/[0.08] bg-white/[0.02] p-2">
        <div class="bezel-core relative overflow-hidden rounded-[calc(2rem-0.5rem)] bg-ink-950 p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.08)]">
          <div class="pointer-events-none absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/10 blur-3xl"></div>

          <div class="relative mx-auto mb-8 flex w-max animate-float flex-col items-center">
            <div class="grid h-16 w-16 place-items-center rounded-2xl border border-brand/30 bg-brand/10 text-brand shadow-[0_0_40px_-6px_var(--color-brand)]">
              <Icon name="eye" class="h-7 w-7" />
            </div>
            <span class="mt-3 font-mono text-xs text-mist-400">~/.claude · motor</span>
          </div>

          <svg viewBox="0 0 300 90" class="mx-auto mb-2 w-full max-w-sm" aria-hidden="true">
            {
              [40, 113, 187, 260].map((x) => (
                <line x1="150" y1="0" x2={x} y2="78" stroke="url(#g)" stroke-width="1" stroke-dasharray="3 4" />
              ))
            }
            <defs>
              <linearGradient id="g" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#38e2c8" stop-opacity="0.7" />
                <stop offset="1" stop-color="#38e2c8" stop-opacity="0.05" />
              </linearGradient>
            </defs>
          </svg>

          <div class="grid grid-cols-4 gap-2">
            {
              repos.map((r, i) => (
                <div
                  data-reveal
                  style={`--reveal-delay: ${240 + i * 70}ms`}
                  class="flex flex-col items-center gap-1.5 rounded-xl border border-white/[0.06] bg-white/[0.03] px-1 py-3"
                >
                  <span class={i % 2 === 0 ? 'text-http' : 'text-constant'}>
                    <Icon name="terminal" class="h-4 w-4" />
                  </span>
                  <span class="font-mono text-[11px] text-mist-300">{r}</span>
                </div>
              ))
            }
          </div>
          <p class="mt-5 text-center font-mono text-[11px] text-mist-500">datos por repo · argos.config.json</p>
        </div>
      </div>
    </div>
  </div>
</section>
